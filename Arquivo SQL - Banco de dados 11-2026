-- Cria um novo banco de dados chamado "Empresa"
create database Empresa;

-- Seleciona o banco "empresa" para que os próximos comandos rodem dentro dele
USE empresa;

-- Cria a tabela "funcionarios" e define suas colunas e tipos de dados
create table funcionarios (
id int auto_increment primary key,
nome varchar(100),
departamento varchar(20),
salario decimal(10,2),
data_admissao date
);

-- Insere um único registro preenchendo todas as colunas na ordem da tabela
