(default,'Maria', 'Financeiro', 2700.00, '2014-06-19'),
(default,'Nicolas', 'Ti', 3500.00, '2024-05-20');


select * from funcionarios;

-- Converte os nomes para MAIÚSCULAS e cria apelidos (AS) para exibição das colunas
select upper(nome) as "Nome do Funcionário", 
departamento as "Área de Atuação" from funcionarios;

-- Busca todas as colunas (*) apenas dos funcionários do departamento de 'Ti'
select * from funcionarios where departamento = 'Ti';

-- Soma os salários por departamento e ordena do maior total para o menor (DESC)
select departamento, sum(salario) as Total_salarios from funcionarios
group by departamento 
order by Total_salarios desc;

-- Filtra e exibe apenas os funcionários cujo nome começa com a letra 'A'
select * from funcionarios where nome like 'A%';
